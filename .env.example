# =====================================================================
# NEXUS E-Learning & Assessment Platform Configuration
# Target: Supabase Cloud & Local Environment
# =====================================================================

# Server Settings
PORT=6966
HOST=0.0.0.0
DEBUG=True

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_multi_tenant_lms_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE
# ---------------------------------------------------------------------
# To use Supabase PostgreSQL:
# 1. Open your Supabase Dashboard -> Settings -> Database
# 2. Copy the Connection String (URI / Pooler string)
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------------
# SUPABASE API & CLOUD STORAGE
# ---------------------------------------------------------------------
# Copy from Supabase Dashboard -> Settings -> API
# Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=platform-media
STORAGE_BACKEND=local